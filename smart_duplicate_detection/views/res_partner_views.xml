<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_partner_form_duplicate_detection"
            model="ir.ui.view">

        <field name="name">
            res.partner.form.duplicate.detection
        </field>

        <field name="model">res.partner</field>

        <field name="inherit_id"
               ref="base.view_partner_form"/>

        <field name="arch"
               type="xml">

            <field name="email"
                   position="attributes">
                <attribute name="placeholder">
                    Duplicate detection enabled
                </attribute>
            </field>

        </field>

    </record>

</odoo>