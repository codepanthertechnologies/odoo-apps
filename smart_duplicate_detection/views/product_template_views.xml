<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_product_form_duplicate_detection"
            model="ir.ui.view">

        <field name="name">
            product.template.form.duplicate.detection
        </field>

        <field name="model">product.template</field>

        <field name="inherit_id"
               ref="product.product_template_only_form_view"/>

        <field name="arch"
               type="xml">

            <field name="barcode"
                   position="attributes">
                <attribute name="placeholder">
                    Duplicate detection enabled
                </attribute>
            </field>

        </field>

    </record>

</odoo>